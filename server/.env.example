PORT=5000
DATABASE_URL="file:./dev.db"
CLIENT_URL="http://localhost:5173"

# Admin Portal authentication (required in production)
ADMIN_PIN=1234
ADMIN_TOKEN_SECRET=replace_with_a_long_random_secret

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# KHQRPay (khqr.cc) Automatic ABA KHQR Gateway
# Store Secret Key securely here (never committed or exposed to frontend)
KHQRPAY_ENABLED=true
KHQRPAY_PROFILE_ID=your_profile_id_here
KHQRPAY_SECRET_KEY=your_secret_key_here
KHQRPAY_ENDPOINT=
