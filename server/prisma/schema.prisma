generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Category {
  id        String    @id @default(uuid())
  nameKh    String
  nameEn    String
  slug      String    @unique
  icon      String?
  image     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String   @id @default(uuid())
  nameKh        String
  nameEn        String
  descriptionKh String?
  descriptionEn String?
  price         Float
  salePrice     Float?
  stock         Int      @default(10)
  images        String   // JSON string array of image URLs
  variants      String?  // JSON string array e.g. [{"name": "Size", "options": ["S", "M", "L"]}]
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id               String   @id @default(uuid())
  orderNumber      String   @unique
  customerName     String
  customerPhone    String
  customerTelegram String?
  address          String
  cityProvince     String
  notes            String?
  paymentMethod    String   // "cod" or "khqr"
  paymentProof     String?  // uploaded receipt screenshot
  status           String   @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  items            String   // JSON string array of items
  subtotal         Float
  deliveryFee      Float    @default(1.5)
  totalAmount      Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}
